# ==============================================================================
# FoodDelivery Application Environment Configuration
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=fooddelivery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5001

# Spring Boot Backend Configuration
BACKEND_PORT=8081
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-db:5432/fooddelivery
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# React / Vite Frontend Configuration
FRONTEND_PORT=4001
VITE_API_BASE_URL=http://localhost:8081/api/users

# Deployment Host IP / Domain
SERVER_IP=localhost
